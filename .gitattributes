# Every text file is stored and checked out with LF, whatever platform it is checked out on, so a file
# reads the same everywhere and a generator writing one produces the same bytes on any machine. Declaring
# the default rather than a list of extensions means a file type nobody has added yet is already right.
* text=auto eol=lf

# The exception, and the only one: cmd.exe parses a batch file line by line as it runs it, and mishandles
# a label or a goto that ends in LF alone.
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.tiff binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
*.7z binary
*.rar binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.snk binary
*.pfx binary
*.mp4 binary
*.wav binary
