<Project>

    <!--
        DOMQL Build Properties

        Shared properties for all DOMQL projects.
    -->

    <PropertyGroup>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <!-- Reports the .editorconfig IDE* code-style severities from the compiler, not just the IDE. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
