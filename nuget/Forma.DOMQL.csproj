<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <StaticWebAssetBasePath>_content/domql</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The package a host references. It ships DOMQL as the one bundled file wwwroot/domql.js, which scripts/bundle.mjs makes from src/. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>formaui-net.DOMQL</PackageId>
        <Version>1.0.0-preview.2</Version>
        <Authors>Eyal Alon</Authors>
        <Description>DOMQL is an extensible language for querying browser state and events. Read state once, watch for changes, or project event data through a unified query model.</Description>
        <PackageTags>domql;dom;query;language;csharp;javascript;dotnet;browser;forma;formaui</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Forma.DOMQL</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Forma.DOMQL</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- A package without the bundle would ship nothing, so packing stops until publish.ps1 has made it. -->
    <Target Name="EnsureBundle" BeforeTargets="Pack">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\domql.js')" Text="wwwroot/domql.js is missing; run ./publish.ps1, which bundles DOMQL and packs it." />
    </Target>

</Project>
