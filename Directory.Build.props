<Project>

    <!--
        DOMQL Build Properties

        Shared properties for every DOMQL project.
    -->

    <!-- Every project targets the same framework and language settings as Forma, which references it beside this repository. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <!-- The one version every package ships at; a preview, as the framework it targets is. -->
    <PropertyGroup>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>preview</VersionSuffix>
    </PropertyGroup>

    <!-- Reports the .editorconfig IDE* code-style severities from the compiler, not just the IDE. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
